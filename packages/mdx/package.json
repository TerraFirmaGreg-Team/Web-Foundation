    "estree-util-value-to-estree": "^3.5.0",
    "fumadocs-docgen": "^3.2.0",
    "fumadocs-twoslash": "^4.0.4",
    "fumadocs-typescript": "5.6.0",
    "gemoji": "^8.1.0",
    "lucide-react": "catalog:",
    "mdast-util-to-string": "^4.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "catalog:",
    "remark-math": "^6.0.0",
    "remark-parse": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "^5.2.0"
  },
  "peerDependencies": {
    "@fumadocs/story": "^1.5.3",
    "@fumari/stf": "^1.1.2",

{
  "name": "@terrafirmagreg-team/analytics",
  "version": "1.2.6",
  "type": "module",
  "description": "Wiki analytics",
  "license": "LGPL-3.0-only",
  "exports": {
    ".": "./src/components/index.ts",
    "./server": "./src/lib/index.ts",
    "./lib/*": [
      "./src/lib/*.ts",
      "./src/lib/*/index.ts"
    ],
    "./components/*": [
      "./src/components/*.tsx",
      "./src/components/*/index.tsx",
      "./src/components/*/index.ts"
    ],
    "./hooks/*": [
      "./src/hooks/*.ts",
      "./src/hooks/*/index.ts"
    ]
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@terrafirmagreg-team/data": "workspace:^",
    "@terrafirmagreg-team/translate": "workspace:^",
    "lucide-react": "catalog:",
    "server-only": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TerraFirmaGreg-Team/Web-Foundation.git",
    "directory": "packages/analytics"
  },
  "publishConfig": {
    "access": "public"
  }
}
